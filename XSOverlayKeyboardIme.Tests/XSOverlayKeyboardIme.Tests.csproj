<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>XSOverlayKeyboardIme.Tests</RootNamespace>
    <AssemblyName>XSOverlayKeyboardIme.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Compile sources without game dependencies instead of referencing the
       plugin assembly, which needs UnityEngine when it loads. Everything under
       Takeover must stay free of game types for this to keep working. -->
  <ItemGroup>
    <Compile Include="..\XSOverlayKeyboardIme\Ime\ComposerState.cs" LinkBase="Linked\Ime" />
    <Compile Include="..\XSOverlayKeyboardIme\Ime\ImeChoice.cs" LinkBase="Linked\Ime" />
    <Compile Include="..\XSOverlayKeyboardIme\Ime\CompositionSelection.cs" LinkBase="Linked\Ime" />
    <Compile Include="..\XSOverlayKeyboardIme\Ime\CompositionView.cs" LinkBase="Linked\Ime" />
    <Compile Include="..\XSOverlayKeyboardIme\Ime\InlinePreeditWatch.cs" LinkBase="Linked\Ime" />
    <Compile Include="..\XSOverlayKeyboardIme\Ime\LanguageProfile.cs" LinkBase="Linked\Ime" />
    <Compile Include="..\XSOverlayKeyboardIme\Ime\LanguageBarIcon.cs" LinkBase="Linked\Ime" />
    <Compile Include="..\XSOverlayKeyboardIme\Ime\InputModeView.cs" LinkBase="Linked\Ime" />
    <Compile Include="..\XSOverlayKeyboardIme\Takeover\**\*.cs" LinkBase="Linked\Takeover" />
    <Compile Include="..\XSOverlayKeyboardIme\Input\**\*.cs" LinkBase="Linked\Input" />
    <Compile Include="..\XSOverlayKeyboardIme\Page\ComposerStatePayload.cs" LinkBase="Linked\Page" />
    <Compile Include="..\XSOverlayKeyboardIme\Page\PageMessages.cs" LinkBase="Linked\Page" />
    <Compile Include="..\XSOverlayKeyboardIme\Page\CompositionPayload.cs" LinkBase="Linked\Page" />
    <Compile Include="..\XSOverlayKeyboardIme\Page\JavaScriptJson.cs" LinkBase="Linked\Page" />
    <Compile Include="..\XSOverlayKeyboardIme\Page\SwitchIconPayload.cs" LinkBase="Linked\Page" />
    <Compile Include="..\XSOverlayKeyboardIme\Interop\Win32Structs.cs" LinkBase="Linked\Interop" />
  </ItemGroup>
</Project>
