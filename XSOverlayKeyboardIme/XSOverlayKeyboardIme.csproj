<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>XSOverlayKeyboardIme</AssemblyName>
    <RootNamespace>XSOverlayKeyboardIme</RootNamespace>
    <Product>XSOverlay Keyboard IME</Product>
    <Version>0.1.1</Version>
    <BepInExPluginGuid>cc.lgck.xsoverlay.keyboardime</BepInExPluginGuid>
  </PropertyGroup>

  <!-- Unity 2022.3 runs the plugin on Mono, and its assemblies are compiled
       against netstandard 2.1, so this must stay at 2.1 or higher. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\XSOverlay_Beta</GameDir>
    <ManagedDir>$(GameDir)\XSOverlay_Data\Managed</ManagedDir>
    <PluginsDir>$(GameDir)\BepInEx\plugins</PluginsDir>
    <CoreDir>$(GameDir)\BepInEx\core</CoreDir>
    <PageBundle>$(MSBuildThisFileDirectory)..\web\dist\keyboard-ime.js</PageBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <!-- Reference the real game assemblies instead of stub packages: this keeps the
       compile-time API surface identical to the runtime. -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="uOSC.Runtime">
      <HintPath>$(ManagedDir)\uOSC.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vuplex.WebView">
      <HintPath>$(ManagedDir)\Vuplex.WebView.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamVR">
      <HintPath>$(ManagedDir)\SteamVR.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(CoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The page script ships inside the plugin DLL, so the plugin stays one file.
       Build it with the web build script. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PageBundle)" LogicalName="keyboard-ime.js" />
  </ItemGroup>

  <Target Name="RequirePageBundle" BeforeTargets="BeforeBuild" Condition="!Exists('$(PageBundle)')">
    <Error Text="The keyboard page script is missing. Run pnpm --dir web build first." />
  </Target>
</Project>
