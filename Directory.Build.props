<Project>
  <!-- Settings shared by every project. Target framework, packages and game
       references live in each project file, because the plugin targets the
       Unity runtime while the tests target the current .NET runtime. -->
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
